# Copy to `.env` in this same folder (repo root).
# Paste OPENAI_API_KEY only. URL and model default to official OpenAI + gpt-4o.
# The in-app Agent connection form takes precedence once settings have been saved.
# Values are read only by the main process.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional override for a local/compatible server instead of OpenAI.
# If SENTINEL_LLM_BASE_URL is set, these names win over OPENAI_*.
# SENTINEL_LLM_BASE_URL=http://localhost:11434/v1
# SENTINEL_LLM_MODEL=
# SENTINEL_LLM_API_KEY=

# Detector used by Ctrl+Shift+3 and Select Meeting Window.
SENTINEL_DETECTOR=http
DETECTOR_URL=https://overtime-lying-musky.ngrok-free.dev/analyze
