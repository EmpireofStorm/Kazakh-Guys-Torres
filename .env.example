# Copy to `.env` in this same folder (repo root).
# Optional initial settings. The in-app Agent connection form takes precedence
# once settings have been saved. Values are read only by the main process.
# No provider is contacted until both the base URL and model are configured.
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_MODEL=
SENTINEL_LLM_API_KEY=
# Example base URL for a local compatible server: http://localhost:11434/v1
# Model ID must match a model on your server that supports function tools.

# Detector used by Ctrl+Shift+3 and Select Meeting Window.
SENTINEL_DETECTOR=http
DETECTOR_URL=https://overtime-lying-musky.ngrok-free.dev/analyze
